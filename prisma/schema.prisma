generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String
  description String
  coverImage  String
  images      String   @default("[]")
  tags        String   @default("[]")
  client      String?
  year        Int?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model About {
  id        String   @id @default(uuid())
  bio       String
  avatar    String
  skills    String   @default("[]")
  socials   String   @default("{}")
  updatedAt DateTime @updatedAt
}

model Contacts {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}